_ms": 79517, "end_ms": 86134, "text_sk": "Som si istý, keď sa ročné obdobia menia", "words": [{"text": "I'm", "start_ms": 79517, "end_ms": 79865}, {"text": "confident", "start_ms": 79935, "end_ms": 82651}, {"text": "as", "start_ms": 82756, "end_ms": 83104}, {"text": "seasons", "start_ms": 83174, "end_ms": 84358}, {"text": "change", "start_ms": 84393, "end_ms": 86134}]}, {"text": "Your faithfulness remains", "start_ms": 86169, "end_ms": 90070, "text_sk": "Tvoja vernosť zostáva", "words": [{"text": "Your", "start_ms": 86169, "end_ms": 86378}, {"text": "faithfulness", "start_ms": 86448, "end_ms": 89199}, {"text": "remains", "start_ms": 89304, "end_ms": 90070}]}, {"text": "You go", "start_ms": 102574, "end_ms": 104908, "text_sk": "Ideš", "words": [{"text": "You", "start_ms": 102574, "end_ms": 102888}, {"text": "go", "start_ms": 102957, "end_ms": 104908}]}, {"text": "You go before me", "start_ms": 104977, "end_ms": 108008, "text_sk": "Ideš predo mnou", "words": [{"text": "You", "start_ms": 104977, "end_ms": 105152}, {"text": "go", "start_ms": 105186, "end_ms": 105813}, {"text": "before", "start_ms": 105883, "end_ms": 106649}, {"text": "me", "start_ms": 106684, "end_ms": 108008}]}, {"text": "To prepare the blessing", "start_ms": 108077, "end_ms": 111421, "text_sk": "Pripraviť požehnanie", "words": [{"text": "To", "start_ms": 108077, "end_ms": 108217}, {"text": "prepare", "start_ms": 108251, "end_ms": 109087}, {"text": "the", "start_ms": 109122, "end_ms": 109261}, {"text": "blessing", "start_ms": 109296, "end_ms": 111421}]}, {"text": "You've made a way", "start_ms": 111491, "end_ms": 115496, "text_sk": "Pripravil si cestu", "words": [{"text": "You've", "start_ms": 111491, "end_ms": 111804}, {"text": "made", "start_ms": 111874, "end_ms": 112431}, {"text": "a", "start_ms": 112501, "end_ms": 112570}, {"text": "way", "start_ms": 112675, "end_ms": 115496}]}, {"text": "It's more than I could imagine", "start_ms": 115566, "end_ms": 121069, "text_sk": "Je to viac, než si dokážem p
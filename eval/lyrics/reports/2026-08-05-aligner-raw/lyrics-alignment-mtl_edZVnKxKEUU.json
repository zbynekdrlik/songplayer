{"backend_id": "lyrics-alignment-mtl", "backend_revision": 1, "wav_path": "C:\\ProgramData\\SongPlayer\\eval-cache\\edZVnKxKEUU_vocal16k.wav", "duration_ms": 349588, "lines": [{"text": "When the King speaks a word it cannot be overturned", "start_ms": 21873, "end_ms": 25635, "text_sk": "Keď Kráľ vysloví slovo, nemôže byť zvrátené", "words": [{"text": "When", "start_ms": 21873, "end_ms": 22082}, {"text": "the", "start_ms": 22117, "end_ms": 22291}, {"text": "King", "start_ms": 22361, "end_ms": 22744}, {"text": "speaks", "start_ms": 22779, "end_ms": 23023}, {"text": "a", "start_ms": 23162, "end_ms": 23266}, {"text": "word", "start_ms": 23336, "end_ms": 23719}, {"text": "it", "start_ms": 23789, "end_ms": 23928}, {"text": "cannot", "start_ms": 23998, "end_ms": 24451}, {"text": "be", "start_ms": 24485, "end_ms": 24660}, {"text": "overturned", "start_ms": 24764, "end_ms": 25635}]}, {"text": "It's as good as done", "start_ms": 25739, "end_ms": 29362, "text_sk": "Je to tak dobré ako hotové", "words": [{"text": "It's", "start_ms": 25739, "end_ms": 25879}, {"text": "as", "start_ms": 25948, "end_ms": 26088}, {"text": "good", "start_ms": 26157, "end_ms": 26575}, {"text": "as", "start_ms": 26680, "end_ms": 27028}, {"text": "done", "start_ms": 27133, "end_ms": 29362}]}, {"text": "And when Heaven touches Earth it can never be reversed", "start_ms": 29466, "end_ms": 33193, "text_sk": "A keď sa Nebo dotkne Zeme, nikdy to nemôže byť zvrátené", "words": [{"text": "And", "start_ms": 29466, "end_ms": 29605}, {"text": "when", "start_ms": 29675, "end_ms": 29814}, {"text": "Heaven", "start_ms": 29884, "end_ms": 30337}, {"text": "touches", "start_ms": 30407, "end_ms": 30824}, {"text": "Earth", "start_ms": 30929, "end_ms": 31312}, {"text": "it", "start_ms": 31382, "end_ms": 31521}, {"text": "can", "start_ms": 31591, "end_ms": 31800}, {"text": "never", "start_ms": 31835, "end_ms": 32218}, {"text": "be", "start_ms": 32287, "end_ms": 32496}, {"text": "reversed", "start_ms": 32531, "end_ms": 33193}]}, {"text": "It's the Kingdom come", "start_ms": 33263, "end_ms": 36711, "text_sk": "Je to príchod Kráľovstva", "words": [{"text": "It's", "start_ms": 33263, "end_ms": 33402}, {"text": "the", "start_ms": 33472, "end_ms": 33681}, {"text": "Kingdom", "start_ms": 33750, "end_ms": 34621}, {"text": "come", "start_ms": 34691, "end_ms": 36711}]}, {"text": "So get the liars out the way", "start_ms": 36780, "end_ms": 38835, "text_sk": "Takže odstráňte klamárov z cesty", "words": [{"text": "So", "start_ms": 36780, "end_ms": 36955}, {"text": "get", "start_ms": 36989, "end_ms": 37164}, {"text": "the", "start_ms": 37198, "end_ms": 37407}, {"text": "liars", "start_ms": 37442, "end_ms": 37895}, {"text": "out", "start_ms": 37999, "end_ms": 38139}, {"text": "the", "start_ms": 38208, "end_ms": 38383}, {"text": "way", "start_ms": 38417, "end_ms": 38835}]}, {"text": "They don't have the final say", "start_ms": 38905, "end_ms": 40786, "text_sk": "Nemajú posledné slovo", "words": [{"text": "They", "start_ms": 38905, "end_ms": 39079}, {"text": "don't", "start_ms": 39114, "end_ms": 39323}, {"text": "have", "start_ms": 39358, "end_ms": 39567}, {"text": "the", "start_ms": 39602, "end_ms": 39776}, {"text": "final", "start_ms": 39811, "end_ms": 40263}, {"text": "say", "start_ms": 40333, "end_ms": 40786}]}, {"text": "There is only one Sovereign and Supreme", "start_ms": 40821, "end_ms": 45941, "text_sk": "Existuje len jeden Zvrchovaný a Najvyšší", "words": [{"text": "There", "start_ms": 40821, "end_ms": 41030}, {"text": "is", "start_ms": 41099, "end_ms": 41204}, {"text": "only", "start_ms": 41343, "end_ms": 42144}, {"text": "one", "start_ms": 42214, "end_ms": 44025}, {"text": "Sovereign", "start_ms": 44060, "end_ms": 44513}, {"text": "and", "start_ms": 44617, "end_ms": 44826}, {"text": "Supreme", "start_ms": 44861, "end_ms": 45941}]}, {"text": "Every word He speaks is holy", "start_ms": 46045, "end_ms": 54161, "text_sk": "Každé slovo, ktoré vysloví, je sväté", "words": [{"text": "Every", "start_ms": 46045, "end_ms": 46428}, {"text": "word", "start_ms": 46463, "end_ms": 46672}, {"text": "He", "start_ms": 46707, "end_ms": 46916}, {"text": "speaks", "start_ms": 46951, "end_ms": 47369}, {"text": "is", "start_ms": 47473, "end_ms": 47787}, {"text": "holy", "start_ms": 47891, "end_ms": 54161}]}, {"text": "The Lamb of God has overcome", "start_ms": 54230, "end_ms": 57957, "text_sk": "Baránok Boží zvíťazil", "words": [{"text": "The", "start_ms": 54230, "end_ms": 54439}, {"text": "Lamb", "start_ms": 54509, "end_ms": 55136}, {"text": "of", "start_ms": 55205, "end_ms": 55380}, {"text": "God", "start_ms": 55414, "end_ms": 56076}, {"text": "has", "start_ms": 56146, "end_ms": 56355}, {"text": "overcome", "start_ms": 56459, "end_ms": 57957}]}, {"text": "My testimony is His blood", "start_ms": 58027, "end_ms": 61719, "text_sk": "Moje svedectvo je Jeho krv", "words": [{"text": "My", "start_ms": 58027, "end_ms": 58236}, {"text": "testimony", "start_ms": 58305, "end_ms": 59907}, {"text": "is", "start_ms": 60012, "end_ms": 60360}, {"text": "His", "start_ms": 60395, "end_ms": 60569}, {"text": "blood", "start_ms": 60639, "end_ms": 61719}]}, {"text": "And if He said that it is done it is done", "start_ms": 61823, "end_ms": 66247, "text_sk": "A ak povedal, že je to hotové, je to hotové", "words": [{"text": "And", "start_ms": 61823, "end_ms": 62032}, {"text": "if", "start_ms": 62137, "end_ms": 62659}, {"text": "He", "start_ms": 62729, "end_ms": 62938}, {"text": "said", "start_ms": 63007, "end_ms": 63669}, {"text": "that", "start_ms": 63704, "end_ms": 63913}, {"text": "it", "start_ms": 64017, "end_ms": 64157}, {"text": "is", "start_ms": 64226, "end_ms": 64366}, {"text": "done", "start_ms": 64435, "end_ms": 64853}, {"text": "it", "start_ms": 64923, "end_ms": 65097}, {"text": "is", "start_ms": 65167, "end_ms": 65306}, {"text": "done", "start_ms": 65376, "end_ms": 66247}]}, {"text": "So be it God", "start_ms": 66316, "end_ms": 74745, "text_sk": "Tak nech sa stane, Bože", "words": [
, {"text": "hallelujah", "start_ms": 86378, "end_ms": 89826}]}, {"text": "To the Alpha Omega the Master the Maker", "start_ms": 89931, "end_ms": 93901, "text_sk": "Alfa a Omega, Majstrovi, Stvoriteľovi", "words": [{"text": "To", "start_ms": 89931, "end_ms": 90105}, {"text": "the", "start_ms": 90140, "end_ms": 90314}, {"text": "Alpha", "start_ms": 90419, "end_ms": 91254}, {"text": "Omega", "start_ms": 91289, "end_ms": 92021}, {"text": "the", "start_ms": 92056, "end_ms": 92230}, {"text": "Master", "start_ms": 92264, "end_ms": 92961}, {"text": "the", "start_ms": 92996, "end_ms": 93135}, {"text": "Maker", "start_ms": 93205, "end_ms": 93901}]}, {"text": "The name above every other name", "start_ms": 93936, "end_ms": 98882, "text_sk": "Meno nad každým iným menom", "words": [{"text": "The", "start_ms": 93936, "end_ms": 94110}, {"text": "name", "start_ms": 94180, "end_ms": 94633}, {"text": "above", "start_ms": 94737, "end_ms": 97001}, {"text": "every", "start_ms": 97106, "end_ms": 97419}, {"text": "other", "start_ms": 97524, "end_ms": 97872}, {"text": "name", "start_ms": 97942, "end_ms": 98882}]}, {"text": "Give Him all the praise He's holy", "start_ms": 98917, "end_ms": 103340, "text_sk": "Vzdajte Mu všetku chválu, On je svätý", "words": [{"text": "Give", "start_ms": 98917, "end_ms": 99126}, {"text": "Him", "start_ms": 99161, "end_ms": 99335}, {"text": "all", "start_ms": 99405, "end_ms": 99579}, {"text": "the", "start_ms": 99648, "end_ms": 99788}, {"text": "praise", "start_ms": 99857, "end_ms": 100310}, {"text": "He's", "start_ms": 100380, "end_ms": 100693}, {"text": "holy", "start_ms": 100763, "end_ms": 103340}]}, {"text": "The Lamb of God has overcome", "start_ms": 103375, "end_ms": 107067, "text_sk": "Baránok Boží zvíťazil", "words": [{"text": "The", "start_ms": 103375, "end_ms": 103584}, {"text": "Lamb", "start_ms": 103619, "end_ms": 104316}, {"text": "of", "start_ms": 104385, "end_ms": 104525}, {"text": "God", "start_ms": 104594, "end_ms": 105186}, {"text": "has", "st
, {"text": "They have no power over me", "start_ms": 122253, "end_ms": 125980, "text_sk": "Nemajú nado mnou žiadnu moc", "words": [{"text": "They", "start_ms": 122253, "end_ms": 122497}, {"text": "have", "start_ms": 122532, "end_ms": 123159}, {"text": "no", "start_ms": 123228, "end_ms": 123402}, {"text": "power", "start_ms": 123472, "end_ms": 124378}, {"text": "over", "start_ms": 124482, "end_ms": 124865}, {"text": "me", "start_ms": 124900, "end_ms": 125980}]}, {"text": "The One with all authority covers me", "start_ms": 126015, "end_ms": 130473, "text_sk": "Ten, kto má všetku autoritu, ma pokrýva", "words": [{"text": "The", "start_ms": 126015, "end_ms": 126224}, {"text": "One", "start_ms": 126293, "end_ms": 126920}, {"text": "with", "start_ms": 126990, "end_ms": 127547}, {"text": "all", "start_ms": 127652, "end_ms": 127896}, {"text": "authority", "start_ms": 127965, "end_ms": 129080}, {"text": "covers", "start_ms": 129115, "end_ms": 129533}, {"text": "me", "start_ms": 129602, "end_ms": 130473}]}, {"text": "So be it God", "start_ms": 130543, "end_ms": 134235, "text_sk": "Tak nech sa stane, Bože", "words": [{"text": "So", "start_ms": 130543, "end_ms": 130926}, {"text": "be", "start_ms": 130995, "end_ms": 131448}, {"text": "it", "start_ms": 131553, "end_ms": 131901}, {"text": "God", "start_ms": 131936, "end_ms": 134235}]}, {"text": "So be it God", "start_ms": 134304, "end_ms": 138031, "text_sk": "Tak nech sa stane, Bože", "words": [{"text": "So", "start_ms": 134304, "end_ms": 134757}, {"text": "be", "start_ms": 134827, "end_ms": 135279}, {"text": "it", "start_ms": 135349, "end_ms": 135628}, {"text": "God", "start_ms": 135697, "end_ms": 138031}]}, {"text": "So be it God", "start_ms": 138101, "end_ms": 146321, "text_sk": "Tak nech sa stane, Bože", "words": [{"text": "So", "start_ms": 138101, "end_ms": 138519}, {"text": "be", "start_ms": 138553, "end_ms": 138797}, {"text": "it", "start_ms": 138902, "end_ms": 139459}, {"text": "God", "start_ms": 139529, "end_ms": 146321}]}, {"text": "From a throne to a cross", "start_ms": 146390, "end_ms": 150082, "text_sk": "Z trónu na kríž", "words": [{"text": "From", "start_ms": 146390, "end_ms": 146599}, {"text": "a", "start_ms": 146669, "end_ms": 146808}, {"text": "throne", "start_ms": 146843, "end_ms": 148201}, {"text": "to", "start_ms": 148271, "end_ms": 148445}, {"text": "a", "start_ms": 148550, "end_ms": 148724}, {"text": "cross", "start_ms": 148759, "end_ms": 150082}]}, {"text": "Who would pay such a price", "start_ms": 150152, "end_ms": 153879, "text_sk": "Kto by zaplatil takú cenu", "words": [{"text": "Who", "start_ms": 150152, "end_ms": 150326}, {"text": "would", "start_ms": 150396, "end_ms": 150605}, {"text": "pay", "start_ms": 150674, "end_ms": 151963}, {"text": "such", "start_ms": 152033, "end_ms": 152242}, {"text": "a", "start_ms": 152311, "end_ms": 152451}, {"text": "price", "start_ms": 152485, "end_ms": 153879}]}, {"text": "For the sins of the world", "start_ms": 153948, "end_ms": 157605, "text_sk": "Za hriechy sveta", "words": [{"text": "For", "start_ms": 153948, "end_ms": 154122}, {"text": "the", "start_ms": 154192, "end_ms": 154401}, {"text": "sins", "start_ms": 154436, "end_ms": 155759}, {"text": "of", "start_ms": 155899, "end_ms": 156038}, {"text": "the", "start_ms": 156108, "end_ms": 156317}, {"text": "world", "start_ms": 156386, "end_ms": 157605}]}, {"text": "Here's your King crucified", "start_ms": 157675, "end_ms": 161437, "text_sk": "Tu je váš Kráľ ukrižovaný", "words": [{"text": "Here's", "start_ms": 157675, "end_ms": 157919}, {"text": "your", "start_ms": 157989, "end_ms": 158163}, {"text": "King", "start_ms": 158232, "end_ms": 159521}, {"text": "crucified", "start_ms": 159591, "end_ms": 161437}]}, {"text": "See the nails in His hands", "start_ms": 161506, "end_ms": 165233, "text_sk": "Pozrite na klince v Jeho rukách", "words": [{"text": "See", "start_ms": 161506, "end_ms": 161681}, {"text": "the", "start_ms": 161750, "end_ms": 161924}, {"text": "nails", "start_ms": 161